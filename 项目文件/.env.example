# ==================== 数据库配置 ====================
POSTGRES_USER=workbench
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=unified_workbench
DATABASE_URL=postgresql+asyncpg://workbench:your_secure_password_here@db:5432/unified_workbench

# ==================== Redis 配置 ====================
REDIS_URL=redis://redis:6379/0

# ==================== 应用配置 ====================
APP_NAME=一站式工作台
DEBUG=true
SECRET_KEY=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================
# 允许的前端域名，逗号分隔
CORS_ORIGINS=http://localhost,http://localhost:3000

# ==================== 存储路径 ====================
# 文件共享存储路径（挂载到容器内）
FILE_STORAGE_PATH=/data/files
# 备份存储路径
FILE_BACKUPS_PATH=/data/backups
# 保留磁盘空间（GB），低于此值拒绝上传
RESERVED_DISK_SPACE_GB=10
# 文件共享最大单个文件大小（GB）
MAX_SHARE_FILE_SIZE_GB=1

# ==================== Celery 配置 ====================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== 初始管理员配置 ====================
# 首次启动时自动创建的管理员账号
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# ==================== 流媒体配置 ====================
# 本机局域网 IP（用于 WebRTC ICE 连接，启动脚本自动检测并注入）
# 手动启动时设置：export HOST_IP=192.168.x.x && docker compose up -d
# 使用 start.sh 启动则自动检测
# HOST_IP=
